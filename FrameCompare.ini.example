; FrameCompare v1.3 portable configuration example
; Hotkeys are stored as: VK,Ctrl,Shift,Alt
; Configure them from the in-game UI whenever possible.

[General]
Enabled=1
Language=0
; 0 = Exact snapshot pair, 1 = Live pipeline
Strategy=0
; Live mode only: 0 = Auto NGX->PreFX, 1 = strict NGX Feature18, 2 = Pre-ReShade FX
LiveCaptureMode=0
BeforeOnLeft=1
; 0 = normal wipe, 1 = SplitScreenCR-style split
DisplayMode=1

[Divider]
Position=0.500000
Step=0.020000
HoldDelay=0.250000
MoveSpeed=0.250000
AutoSweepSpeed=0.200000
AutoSweepPingPong=0
AutoResetFromBefore=1
AutoSweepDirection=1
ShowBorder=1
BorderWidth=0.002000
BorderOpacity=1.000000
ScreenDrag=1
DragGrabPx=14.000000

[Labels]
Show=1
Preview=0
BeforeText=OFF
AfterText=ON
BeforeX=0.000000
BeforeY=0.000000
AfterX=1.000000
AfterY=0.000000
FontSizePx=42
Opacity=1.000000
OutlinePx=2.000000
MarginPx=18.000000

[Hotkeys]
; F9
ToggleCompare=120,0,0,0
; F10 (Live mode freeze)
ToggleFreeze=121,0,0,0
; F11
ToggleAutoSweep=122,0,0,0
; Left / Right
MoveLeft=37,0,0,0
MoveRight=39,0,0,0
; Ctrl+Left / Ctrl+Right (avoids default Home/End conflicts)
FullBefore=37,1,0,0
FullAfter=39,1,0,0
; F7 / F8 exact captures
CaptureBefore=118,0,0,0
CaptureAfter=119,0,0,0

[HUD]
Count=0
; HUD Source: 0=hotkey toggle, 1=actual ReShade Effects State,
;             2=hotkey hold, 3=one-shot message.

; Example: show the *actual* ReShade effects state.
; No duplicate END hotkey is required because Source=1 polls ReShade itself.
; Increase Count to 1 and uncomment this section to enable it.
;
; [HUD.0]
; Enabled=1
; Name=ReShadeState
; Source=1
; Hotkey=0,0,0,0
; TextOn=ON
; TextOff=OFF
; InitialOn=1
; X=0.500000
; Y=0.080000
; ShowSeconds=1.000000

[NGX]
MaxSnapshotAgeMs=250
D3D12ColorState=0x40
AllowUnsafeCrossDevice=0

[Diagnostics]
VerboseLogging=0
